rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 관리자 권한 판별: 지정된 관리자 이메일(대소문자 무관)이거나 서버에 이미 검증 저장된 관리자 계정
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'admin@univmeeting.kr') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // 서버의 verificationRequests 문서에 이미 승인(approved) 기록이 존재하는지 확인
    function hasServerApprovedVerification(uid) {
      return exists(/databases/$(database)/documents/verificationRequests/$(uid))
        && get(/databases/$(database)/documents/verificationRequests/$(uid)).data.status == 'approved';
    }

    // 운영팀 승인 완료(approved)된 재학생인지 서버 문서 기준으로 직접 검증 (클라이언트 위조 차단)
    function isApprovedStudent() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved') ||
        hasServerApprovedVerification(request.auth.uid)
      );
    }

    // HTML 태그 및 javascript: 스크립트 삽입 차단
    function isSafeString(val, minLen, maxLen) {
      return val is string
        && val.size() >= minLen
        && val.size() <= maxLen
        && !val.matches('.*[<>].*')
        && !val.matches('(?i).*javascript\\s*:.*');
    }

    // 1. 회원 프로필 (/users/{userId})
    // - 본인 또는 관리자만 단건 조회 가능 (타 학생 학번·이메일 열람 및 전체 목록 덤프 차단)
    // - 일반 회원은 절대 isAdmin=true 또는 임의 verified=true 셀프 승격 불가 (서버 승인 문서 존재 시에만 동기화 허용)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == userId
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && request.resource.data.gender in ['남', '여']
        && isSafeString(request.resource.data.name, 2, 20)
        && isSafeString(request.resource.data.university, 2, 60)
        && isSafeString(request.resource.data.department, 1, 50)
        && (
          (request.resource.data.verified == false
           && request.resource.data.verificationStatus in ['unverified', 'pending'])
          ||
          (hasServerApprovedVerification(userId)
           && request.resource.data.verified == true
           && request.resource.data.verificationStatus == 'approved')
        )
      );

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && request.resource.data.gender in ['남', '여']
        && isSafeString(request.resource.data.name, 2, 20)
        && isSafeString(request.resource.data.university, 2, 60)
        && isSafeString(request.resource.data.department, 1, 50)
        && (
          // 미인증 또는 인증 심사 신청(pending) 상태 전환 허용 (셀프 approved 위조 차단)
          (request.resource.data.verified == false
           && request.resource.data.verificationStatus in ['unverified', 'pending'])
          ||
          // 서버 verificationRequests 문서가 이미 approved인 경우 본인 프로필 동기화 허용
          (hasServerApprovedVerification(userId)
           && request.resource.data.verified == true
           && request.resource.data.verificationStatus == 'approved')
          ||
          // 이미 승인된 회원이 동일 학교·학번을 유지한 채 프로필 동기화하는 경우 허용
          (resource.data.verified == true
           && resource.data.verificationStatus == 'approved'
           && request.resource.data.verified == true
           && request.resource.data.verificationStatus == 'approved'
           && request.resource.data.university == resource.data.university
           && request.resource.data.studentId == resource.data.studentId)
        )
      );

      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. 재학증명서 인증 신청 (/verificationRequests/{requestId})
    // - 민감 개인정보(학번·재학증명서 원본) 보호: 본인 소유 문서(uid 일치 포함) 및 관리자만 조회 허용!
    // - 학생은 status == 'pending' 및 검증된 이미지/PDF Base64만 제출 가능
    match /verificationRequests/{requestId} {
      allow get: if isOwner(requestId)
        || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid)
        || isAdmin();
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create, update: if isAdmin() || (
        isOwner(requestId)
        && request.resource.data.id == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.gender in ['남', '여']
        && isSafeString(request.resource.data.userName, 2, 20)
        && isSafeString(request.resource.data.university, 2, 60)
        && isSafeString(request.resource.data.department, 1, 50)
        && isSafeString(request.resource.data.studentId, 4, 16)
        && request.resource.data.certificateMimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.data.certificateDataUrl is string
        && request.resource.data.certificateDataUrl.size() > 30
        && request.resource.data.certificateDataUrl.size() < 950000
        && request.resource.data.certificateDataUrl.matches('^data:(image/(jpeg|png|webp)|application/pdf);base64,[A-Za-z0-9+/=]+$')
      );

      allow delete: if isOwner(requestId) || isAdmin();
    }

    // 3. 미팅 방 (/rooms/{roomId})
    // - 생성: 승인된 재학생만 가능, 본인 UID 방장 강제
    // - 수정: 방 핵심 정보 불변 강제 + 승인된 재학생만 팀원 슬롯 참여/취소 가능
    // - 삭제: 방장 본인 또는 관리자만 가능 (URL/쿼리 ID 변조 삭제 차단)
    match /rooms/{roomId} {
      allow read: if true;

      allow create: if isApprovedStudent()
        && request.resource.data.id == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.format in ['2:2', '3:3', '4:4']
        && request.resource.data.status == '모집 중'
        && isSafeString(request.resource.data.title, 2, 80)
        && isSafeString(request.resource.data.intro, 2, 500)
        && request.resource.data.leftMembers is list
        && request.resource.data.leftMembers.size() == 1
        && request.resource.data.rightMembers is list
        && request.resource.data.rightMembers.size() == 0;

      allow update: if isAdmin() || (
        isApprovedStudent()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'title',
          'format',
          'leftUniversity',
          'rightUniversity',
          'schedule',
          'location',
          'intro',
          'hostUid',
          'hostDepartment',
          'createdAt'
        ])
        && request.resource.data.status in ['모집 중', '성사 완료']
        && request.resource.data.leftMembers is list
        && request.resource.data.leftMembers.size() <= 4
        && request.resource.data.rightMembers is list
        && request.resource.data.rightMembers.size() <= 4
      );

      allow delete: if (isSignedIn() && resource.data.hostUid == request.auth.uid) || isAdmin();
    }

    // 4. 게시판 모집글 (/posts/{postId})
    // - 생성: 승인된 재학생만 가능, 작성자 UID 일치 강제
    // - 수정: 작성자 상태 변경(모집 중/마감) 또는 승인 재학생 신청 목록 변경만 허용
    // - 삭제: 작성자 본인 또는 관리자만 가능
    match /posts/{postId} {
      allow read: if true;

      allow create: if isApprovedStudent()
        && request.resource.data.id == postId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.tab in ['meeting', 'teammate']
        && request.resource.data.format in ['2:2', '3:3', '4:4']
        && request.resource.data.status == '모집 중'
        && isSafeString(request.resource.data.title, 2, 100)
        && isSafeString(request.resource.data.content, 2, 1000)
        && request.resource.data.applicants is list
        && request.resource.data.applicants.size() == 0;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['모집 중', '마감']
        )
        || (
          isApprovedStudent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants'])
          && request.resource.data.applicants is list
          && request.resource.data.applicants.size() <= 50
        );

      allow delete: if (isSignedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // 5. 신고 접수 (/reports/{reportId}) — 관리자만 열람·삭제 가능, 수정 불가
    match /reports/{reportId} {
      allow create: if request.resource.data.targetType in ['room', 'post', 'general']
        && isSafeString(request.resource.data.reason, 1, 40)
        && isSafeString(request.resource.data.detail, 0, 500)
        && request.resource.data.createdAt is number;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 6. 1:1 문의 (/inquiries/{inquiryId}) — 관리자만 열람·삭제 가능, 수정 불가
    match /inquiries/{inquiryId} {
      allow create: if isSafeString(request.resource.data.content, 2, 1000)
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.createdAt is number;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 그 외 모든 미정의 경로 원천 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
